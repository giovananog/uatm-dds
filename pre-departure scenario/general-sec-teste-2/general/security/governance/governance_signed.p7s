        <topic_rule>
          <topic_expression>flightRequestInfo</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          tolPadRequest:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>tolPadRequest</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          flightRouteInfo:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>flightRouteInfo</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          weatherInfo:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>weatherInfo</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
