<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <domain_access_rules>
    <domain_rule>
      <!-- Domain don't allow unauthenticated participants to join -->
      <domains>
        <id>0</id>
      </domains>
      <allow_unauthenticated_participants>false</allow_unauthenticated_participants>
      <enable_join_access_control>true</enable_join_access_control>
      <discovery_protection_kind>NONE</discovery_protection_kind>
      <liveliness_protection_kind>NONE</liveliness_protection_kind>
      <rtps_protection_kind>NONE</rtps_protection_kind>

      <topic_access_rules>
        <!--
          flightCoordination:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>flightCoordination</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          flightAuthorizationRequest:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>flightAuthorizationRequest</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          flightRequestInfo:
          - Protected for read and write access.
          - Use regular unsecured discovery
