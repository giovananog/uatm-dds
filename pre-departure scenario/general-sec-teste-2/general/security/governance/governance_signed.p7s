          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>trafficFlowsInfo</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          flightChangeRec:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>flightChangeRec</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
        </topic_rule>

        <!--
          flightAuthorization:
          - Protected for read and write access.
          - Use regular unsecured discovery
        -->
        <topic_rule>
          <topic_expression>flightAuthorization</topic_expression>
          <enable_read_access_control>true</enable_read_access_control>
          <enable_write_access_control>true</enable_write_access_control>
