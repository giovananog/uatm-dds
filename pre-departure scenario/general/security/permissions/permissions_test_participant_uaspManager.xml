 <?xml version="1.0" encoding="utf-8"?>
<!-- Don't edit and sign these by hand, edit and run generate_generic_permissions.pl! -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="TheGrant">
      <subject_name>emailAddress=ff@ff, CN=ff, OU=ff, O=ff, ST=ff, C=ff</subject_name>
      <validity></validity>
      <allow_rule>
        <domains>
          <id_range>
            <min>0</min>
          </id_range>
        </domains>
        <publish>
          <topics>
            <topic>tolPadRequest</topic>
            <topic>acceptableRoute</topic>
            <topic>flightAuthorization</topic>
            <topic>flightChangeRec</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>availabilityInfo</topic>
            <topic>trafficFlowsInfo</topic>
            <topic>flightRequestInfo</topic>
            <topic>airspaceRestrictions</topic>
            <topic>weatherInfo</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
 
