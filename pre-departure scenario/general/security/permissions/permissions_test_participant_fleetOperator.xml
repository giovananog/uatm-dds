 
<?xml version="1.0" encoding="utf-8"?>
<!-- Don't edit and sign these by hand, edit and run generate_generic_permissions.pl! -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="TheGrant">
      <subject_name>emailAddress=zzz, CN=zz, OU=zzz, O=zz, ST=zzz, C=zz</subject_name>
      <validity></validity>
      <allow_rule>
        <domains>
          <id_range>
            <min>0</min>
          </id_range>
        </domains>
        <publish>
          <topics>
            <topic>flightAssign</topic>
            <topic>flightCoordination</topic>
            <topic>flightAuthorizationRequest</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>flightAuthorization</topic>
            <topic>availabilityInfo</topic>
            <topic>flightChangeRec</topic>
            <topic>bookingFlightRequest</topic>
            <topic>flightRoutesInfo</topic>
            <topic>weatherInfo</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
